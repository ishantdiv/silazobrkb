    <script>

        document.addEventListener('DOMContentLoaded', function() {

            // Mobile accordion functionality

            const footerTitles = document.querySelectorAll('.footer-col h4');

            footerTitles.forEach(title => {

                title.addEventListener('click', () => {

                    const parent = title.parentElement;

                    // Check if this section should be toggleable

                    if (!parent.classList.contains('no-toggle')) {

                        // Close other open sections

                        if (window.innerWidth <= 768) {

                            document.querySelectorAll('.footer-col.active').forEach(col => {

                                if (col !== parent) {
                                    col.classList.remove('active');
                                }

                            });

                        }

                        // Toggle current section

                        parent.classList.toggle('active');

                    }

                });

            });

            // Auto-expand contact section on mobile

            if (window.innerWidth <= 768) {
                document.querySelector('.footer-contact').classList.add('active');
            }

            // Handle window resize

            window.addEventListener('resize', function() {

                if (window.innerWidth > 768) {

                    // On desktop, ensure all sections are expanded

                    document.querySelectorAll('.footer-col').forEach(col => {
                        col.classList.add('active');
                    });

                } else {

                    // On mobile, collapse all except contact

                    document.querySelectorAll('.footer-col:not(.footer-contact)').forEach(col => {
                        col.classList.remove('active');
                    });

                    document.querySelector('.footer-contact').classList.add('active');

                }

            });

            // Initialize state on page load

            if (window.innerWidth > 768) {

                document.querySelectorAll('.footer-col').forEach(col => {
                    col.classList.add('active');
                });

            }

        });

    </script>

