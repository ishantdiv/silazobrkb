<script>
(function() {

  /* ==========================================
     DESKTOP SLIDER
     5 slides
  ========================================== */

  const desktopSlides = document.querySelectorAll(
    "#slidert .desktop-slide"
  );

  let desktopIndex = 0;

  function showDesktopSlide() {

    desktopSlides.forEach(function(slide) {
      slide.style.display = "none";
    });

    if (desktopSlides.length > 0) {
      desktopSlides[desktopIndex].style.display = "block";
    }

    desktopIndex++;

    if (desktopIndex >= desktopSlides.length) {
      desktopIndex = 0;
    }

    setTimeout(showDesktopSlide, 3000);
  }


  /* ==========================================
     MOBILE SLIDER
     4 slides
  ========================================== */

  const mobileSlides = document.querySelectorAll(
    "#slidert .mobile-slide"
  );

  let mobileIndex = 0;

  function showMobileSlide() {

    mobileSlides.forEach(function(slide) {
      slide.style.display = "none";
    });

    if (mobileSlides.length > 0) {
      mobileSlides[mobileIndex].style.display = "block";
    }

    mobileIndex++;

    if (mobileIndex >= mobileSlides.length) {
      mobileIndex = 0;
    }

    setTimeout(showMobileSlide, 3000);
  }


  /* ==========================================
     START BOTH SLIDERS
  ========================================== */

  showDesktopSlide();
  showMobileSlide();

})();
</script>
